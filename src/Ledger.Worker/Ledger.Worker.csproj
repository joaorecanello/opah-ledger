<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Ledger.Worker — processamento em background: consolidação de snapshots,
    reconciliação ledger/snapshot e despacho de outbox.

    Não está no caminho crítico de nenhuma operação: se ele estiver parado, a
    escrita funciona normalmente e a consulta de saldo cai no cálculo direto —
    mais lenta, igualmente correta.
    Ver docs/adr/0004-snapshot-de-saldo.md.
  -->

  <PropertyGroup>
    <RootNamespace>Ledger.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ledger.Application/Ledger.Application.csproj" />
    <ProjectReference Include="../Ledger.Infrastructure/Ledger.Infrastructure.csproj" />
  </ItemGroup>

</Project>
