<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ledger.Application — casos de uso e portas (interfaces).

    Depende do domínio e de mais nada. As implementações das portas
    (repositórios, relógio, unit of work) vivem em Ledger.Infrastructure, que
    depende desta camada e nunca o contrário: inversão de dependência.
  -->

  <PropertyGroup>
    <RootNamespace>Ledger.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Ledger.Domain/Ledger.Domain.csproj" />
  </ItemGroup>

</Project>
