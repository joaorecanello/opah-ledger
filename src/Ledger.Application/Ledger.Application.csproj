<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ledger.Application - casos de uso e portas (interfaces).

    Depende do dominio e de mais nada. As implementacoes das portas
    (repositorios, relogio, unit of work) vivem em Ledger.Infrastructure,
    que depende desta camada e nunca o contrario (inversao de dependencia).
  -->

  <PropertyGroup>
    <RootNamespace>Ledger.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Ledger.Domain/Ledger.Domain.csproj" />
  </ItemGroup>

</Project>
