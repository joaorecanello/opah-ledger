<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Ledger.Api - host HTTP. Processo separado do Worker de proposito (ADR-001):
    trafego sincrono com latencia previsivel nao deve competir por thread pool
    com job de consolidacao em lote.
  -->

  <PropertyGroup>
    <RootNamespace>Ledger.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ledger.Application/Ledger.Application.csproj" />
    <ProjectReference Include="../Ledger.Infrastructure/Ledger.Infrastructure.csproj" />
  </ItemGroup>

</Project>
