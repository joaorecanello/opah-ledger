<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Ledger.Api — host HTTP.

    Processo separado do Worker de propósito: tráfego síncrono com latência
    previsível não deve competir por thread pool com job de consolidação em
    lote. Ver docs/adr/0001-monolito-modular.md.
  -->

  <PropertyGroup>
    <RootNamespace>Ledger.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ledger.Application/Ledger.Application.csproj" />
    <ProjectReference Include="../Ledger.Infrastructure/Ledger.Infrastructure.csproj" />
  </ItemGroup>

</Project>
