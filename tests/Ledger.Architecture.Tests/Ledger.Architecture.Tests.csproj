<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de arquitetura: travam as fronteiras de camada do ADR-0001 e proíbem
    ponto flutuante binário nas camadas de negócio.

    Sem isto, "monólito modular" degrada para "monólito" em poucas sprints,
    porque nada impede um using conveniente. Com isto, a erosão quebra o build
    no dia em que acontece — e é também o que torna a extração de um serviço
    mecânica no futuro.
  -->

  <PropertyGroup>
    <RootNamespace>Ledger.Architecture.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ledger.Domain/Ledger.Domain.csproj" />
    <ProjectReference Include="../../src/Ledger.Application/Ledger.Application.csproj" />
    <ProjectReference Include="../../src/Ledger.Infrastructure/Ledger.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Ledger.Api/Ledger.Api.csproj" />
  </ItemGroup>

</Project>
