<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de integração.

    Hoje: a API em memória, via WebApplicationFactory.
    Depois: PostgreSQL real, via Testcontainers — banco em memória não reproduz
    unique constraint sob concorrência, logo o teste de idempotência passaria
    sem provar nada, que é falso-positivo no cenário onde mais preciso de
    certeza. Ver docs/testes.md.

    Os testes que dependerem de Docker detectam a ausência dele e são ignorados
    com mensagem explícita, para que "dotnet test" nunca falhe por ambiente na
    máquina de quem avalia — requisito obrigatório de README que roda
    localmente, não conveniência.
  -->

  <PropertyGroup>
    <RootNamespace>Ledger.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ledger.Api/Ledger.Api.csproj" />
    <ProjectReference Include="../../src/Ledger.Infrastructure/Ledger.Infrastructure.csproj" />
  </ItemGroup>

</Project>
