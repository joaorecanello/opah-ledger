<Project>

  <!--
    Central Package Management: todas as versões de pacote vivem aqui, e os
    .csproj declaram apenas o Include, nunca a Version.

    Razão: num repositório com vários projetos, versão divergente do mesmo
    pacote entre eles é fonte clássica de bug que só aparece em runtime. Aqui a
    divergência é impossível por construção.

    Pacotes entram conforme o código passa a usá-los — EF Core na persistência,
    Serilog e OpenTelemetry na observabilidade, Testcontainers nos testes de
    integração. A lista abaixo contém apenas o que o código de fato usa hoje:
    dependência declarada e não usada é dívida sem contrapartida.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core e Hosting">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!--
      Sobe a API em memória com WebApplicationFactory: sem porta, sem Docker e
      sem processo externo. Versão casada com o runtime ASP.NET Core 10.0.13.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />

    <!--
      Shouldly (BSD-3) em lugar de FluentAssertions: a partir da v8, o
      FluentAssertions passou a exigir licença paga para uso comercial. Num
      código que seria entregue a um banco isso é passivo jurídico, não
      preferência de estilo.
      Ver docs/adr/0011-biblioteca-de-assercao.md.
    -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />

    <!--
      Testes de arquitetura: protegem as fronteiras de camada do ADR-0001 da
      erosão por "using conveniente".
    -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>

</Project>
