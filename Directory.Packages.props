<Project>

  <!--
    Central Package Management: todas as versões de pacote vivem aqui, e os
    .csproj declaram apenas o Include, nunca a Version.

    Razão: num repositório com vários projetos, versão divergente do mesmo
    pacote entre eles é fonte clássica de bug que só aparece em runtime. Aqui a
    divergência é impossível por construção.

    Pacotes entram conforme o código passa a usá-los — EF Core na persistência,
    Serilog e OpenTelemetry na observabilidade, Testcontainers nos testes de
    integração. A lista abaixo contém apenas o que o código de fato usa hoje:
    dependência declarada e não usada é dívida sem contrapartida.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core e Hosting">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Observabilidade">
    <!--
      OpenTelemetry com exportador OTLP, que é o padrão aberto: a instrumentação
      não muda quando o banco trocar de Datadog para Grafana ou Application
      Insights, só o destino.
    -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
  </ItemGroup>

  <ItemGroup Label="Resiliência">
    <!--
      Polly.Core, e não o metapacote Polly: só o núcleo de estratégias é usado
      (circuit breaker e timeout). O resto traz dependências que o projeto não
      precisa.
    -->
    <PackageVersion Include="Polly.Core" Version="8.9.1" />
  </ItemGroup>

  <ItemGroup Label="Persistência">
    <!--
      O EF Core é declarado explicitamente, e não herdado como dependência
      transitiva do provider. Sem isto há conflito real de assembly: o
      Npgsql 10.0.3 foi compilado contra o EF 10.0.4, o pacote de Design pede
      10.0.13, e como Design entra com PrivateAssets=all a versão dele não flui
      para Ledger.Api — que então resolveria 10.0.4 enquanto
      Ledger.Infrastructure foi compilada contra 10.0.13.

      Declarar aqui é exatamente o que o Central Package Management existe para
      fazer: uma versão, verificada no build, em lugar de qualquer versão que a
      resolução transitiva escolher em cada projeto.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.13" />

    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!--
      Necessário apenas em tempo de design, para gerar migrations. Entra com
      PrivateAssets=all no csproj: não deve ir para o pacote publicado nem
      vazar para quem referencia a infraestrutura.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <!--
      xUnit v3, e não o v2, por um motivo concreto: o v2 não expõe Assert.Skip, e
      o mecanismo de skip dinâmico dele — um prefixo de mensagem definido num
      tipo interno — não é honrado pelo runner. Verifiquei: com o v2, ignorar um
      teste por ausência de banco virava 25 falhas com o token cru na mensagem.
      No v3, Assert.Skip é de primeira classe.

      O v3 traz o próprio runner e o Microsoft.Testing.Platform, logo não há
      Microsoft.NET.Test.Sdk, xunit.runner.visualstudio nem coverlet.collector:
      os três pertencem ao VSTest, que o SDK .NET 10 não suporta mais junto do
      Microsoft.Testing.Platform.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />

    <!--
      Sobe a API em memória com WebApplicationFactory: sem porta, sem Docker e
      sem processo externo. Versão casada com o runtime ASP.NET Core 10.0.13.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />

    <!--
      Shouldly (BSD-3) em lugar de FluentAssertions: a partir da v8, o
      FluentAssertions passou a exigir licença paga para uso comercial. Num
      código que seria entregue a um banco isso é passivo jurídico, não
      preferência de estilo.
      Ver docs/adr/0011-biblioteca-de-assercao.md.
    -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />

    <!--
      Testes de arquitetura: protegem as fronteiras de camada do ADR-0001 da
      erosão por "using conveniente".
    -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!--
      PostgreSQL real nos testes de integração. Banco em memória não reproduz
      unique constraint sob concorrência, logo o teste de idempotência — o mais
      importante da suíte — passaria sem provar nada.
    -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

</Project>
