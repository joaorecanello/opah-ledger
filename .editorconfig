# Padrão de código do projeto. Combinado com EnforceCodeStyleInBuild e
# TreatWarningsAsErrors (Directory.Build.props), isto é verificado no build,
# não apenas sugerido na IDE.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# C#
# ---------------------------------------------------------------------------
[*.cs]

# using
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# namespace em uma linha
csharp_style_namespace_declarations = file_scoped:warning

# this.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# tipos de linguagem: int em vez de Int32
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# var
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent

# expressões modernas
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_braces = true:warning
csharp_prefer_simple_using_statement = true:suggestion

# Imutabilidade. Relevante aqui mais que de hábito: o ledger é append-only e
# movimentação é fato imutável. Ver docs/adr/0002-ledger-append-only.md.
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion

# nulos
csharp_style_conditional_delegate_call = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning

# chaves e espaçamento
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true

# ---------------------------------------------------------------------------
# Nomenclatura
# ---------------------------------------------------------------------------
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

# As regras de nomenclatura são avaliadas na ordem em que aparecem, e a
# primeira que casa vence. Logo as mais específicas (const, static readonly)
# vêm ANTES da regra geral de campo privado — senão ela as captura primeiro e
# passa a exigir "_" onde a convenção C# pede PascalCase.

dotnet_naming_rule.const_fields_pascal.severity = warning
dotnet_naming_rule.const_fields_pascal.symbols = const_field_symbols
dotnet_naming_rule.const_fields_pascal.style = pascal
dotnet_naming_symbols.const_field_symbols.applicable_kinds = field
dotnet_naming_symbols.const_field_symbols.applicable_accessibilities = *
dotnet_naming_symbols.const_field_symbols.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_pascal.severity = warning
dotnet_naming_rule.static_readonly_fields_pascal.symbols = static_readonly_field_symbols
dotnet_naming_rule.static_readonly_fields_pascal.style = pascal
dotnet_naming_symbols.static_readonly_field_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field_symbols.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_field_symbols.required_modifiers = static,readonly

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = prefix_underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.prefix_underscore_camel.required_prefix = _
dotnet_naming_style.prefix_underscore_camel.capitalization = camel_case

dotnet_naming_rule.publics_pascal.severity = warning
dotnet_naming_rule.publics_pascal.symbols = public_symbols
dotnet_naming_rule.publics_pascal.style = pascal
dotnet_naming_symbols.public_symbols.applicable_kinds = property,method,event,class,struct,enum,delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public,internal,protected
dotnet_naming_style.pascal.capitalization = pascal_case

# ---------------------------------------------------------------------------
# Migrations do EF Core: código gerado
# ---------------------------------------------------------------------------
#
# O EF gera estes arquivos, e o que ele gera não segue o padrão de código deste
# repositório — na primeira migration, IDE0161 (namespace com escopo de arquivo)
# e CA1861 (array constante como argumento). Com TreatWarningsAsErrors isso
# quebra o build.
#
# As três saídas possíveis eram: editar o código gerado à mão, que a próxima
# migration desfaz; baixar o nível de análise do projeto inteiro, que joga a
# regra fora onde ela importa; ou excluir da análise o diretório de código
# gerado. Esta é a terceira.
#
# A exclusão é por diretório e só de análise de estilo e qualidade: erro de
# compilação continua sendo erro. O requisito obrigatório de compilar sem
# warnings permanece verificado em todo o código escrito à mão.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ---------------------------------------------------------------------------
# Projetos de teste: relaxamentos justificados
# ---------------------------------------------------------------------------
[tests/**/*.cs]

# CA1707: nomes de teste usam underscore de propósito
# (Metodo_Cenario_ResultadoEsperado), por legibilidade do relatório de falha.
dotnet_diagnostic.CA1707.severity = none

# CA1062: validação de argumento público não se aplica a método de teste.
dotnet_diagnostic.CA1062.severity = none

# CA1515: tipos de teste precisam ser públicos para o runner descobri-los.
dotnet_diagnostic.CA1515.severity = none
