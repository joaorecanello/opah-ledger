<Project>

  <!--
    Higiene de build central.

    O enunciado do desafio exige que o código compile sem erros e sem warnings,
    sob pena de o teste ser desconsiderado. É a restrição mais fácil de violar
    por acidente e a mais objetivamente verificável por quem avalia, logo está
    tratada por construção e não por disciplina.

    Decisões deliberadas:

      - TreatWarningsAsErrors: o build RECUSA compilar fora do padrão. Depender
        de alguém lembrar de conferir na véspera é o pior desenho possível para
        um requisito eliminatório.

      - AnalysisLevel fixado em 10.0, e não em "latest": congela o conjunto de
        regras dos analisadores. Assim um SDK mais novo na máquina de quem
        avalia não introduz regras novas que virariam warning e, por
        consequência, erro.

      - global.json usa rollForward=latestFeature: qualquer SDK .NET 10 serve
        para compilar.

    A combinação das duas últimas parece contraditória e é o ponto: quem avalia
    compila com o SDK que tiver, e as regras que decidem o que é warning não
    mudam com ele.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Higiene de build">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Central Package Management">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

</Project>
